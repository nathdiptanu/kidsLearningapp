<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always draws its own splash with the adaptive launcher icon.
         The window background is a plain colour so a second image is not shown
         after the system splash while Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/sprout_background</item>
    </style>
</resources>
